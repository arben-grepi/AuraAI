# Copy to .env or .env.local. Never commit real secrets.
# Below: required variables first, then optional (integrations).

# =============================================================================
# Required
# =============================================================================

# App URL in the browser (auth redirects, absolute links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Must match the URL users open. Production: https://your-domain.com
# https://www.better-auth.com/docs/installation
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL (Prisma). Local: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# =============================================================================
# Optional
# =============================================================================

# --- Email (Resend: verification, password reset, invites) ---
# If RESEND_API_KEY is set, RESEND_FROM_EMAIL is required for sends (see email/email.ts).
RESEND_API_KEY=
# FROM must use a verified domain in production, or onboarding@resend.dev for tests.
RESEND_FROM_EMAIL=

# --- AWS S3 (org files / RAG uploads — omit if you are not using file storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Same bucket name in both (different env names are used by different API routes).
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_REGION=

# --- AI (Ollama only — OpenAI is not used) ---
# OPENAI_API_KEY is no longer required
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Hugging Face tokenizer id for chunk sizing (default matches nomic-embed-text). Optional.
# OLLAMA_EMBEDDING_TOKENIZER_ID=Xenova/nomic-embed-text-v1
# Hard / soft token limits for RAG chunks (optional; defaults come from the tokenizer model_max_length).
# OLLAMA_EMBEDDING_CHUNK_MAX_TOKENS=8128
# OLLAMA_EMBEDDING_CHUNK_TARGET_TOKENS=7000
# Tests / air-gapped: disable Transformers.js and use character caps only.
# AURA_DISABLE_EMBEDDING_TOKENIZER=1
# Undici headers/body timeout for all Ollama HTTP calls (ms). Raise on slow local hardware (e.g. 900000 = 15 min).
# OLLAMA_FETCH_TIMEOUT_MS=1200000

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Development only (never set in production) ---
# Allow any signed-in user to create an org without admin role (local testing).
# DEV_ALLOW_SELF_ORG_CREATION=1
# Test recipient for scripts/send-test-email.ts
# RESEND_TEST_TO_EMAIL=you@example.com

# --- PDF parsing (pdf2json) ---
# Suppresses noisy-but-harmless Type3 font warnings from pdfjs. Safe to keep on.
PDF2JSON_DISABLE_LOGS=1
