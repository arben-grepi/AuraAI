# Copy to .env or .env.local. Never commit real secrets.
# Below: required variables first, then optional (integrations).

# =============================================================================
# Required
# =============================================================================

# App URL in the browser (auth redirects, absolute links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Must match the URL users open. Production: https://your-domain.com
# https://www.better-auth.com/docs/installation
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL (Prisma). Local: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# =============================================================================
# Optional
# =============================================================================

# --- Email (Resend: verification, password reset, invites) ---
# If RESEND_API_KEY is set, RESEND_FROM_EMAIL is required for sends (see email/email.ts).
RESEND_API_KEY=
# FROM must use a verified domain in production, or onboarding@resend.dev for tests.
RESEND_FROM_EMAIL=

# --- AWS S3 (org files / RAG uploads — omit if you are not using file storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Same bucket name in both (different env names are used by different API routes).
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_REGION=

# --- AI (default provider is OpenAI in lib/ai-provider.ts; use ollama for local-only) ---
OPENAI_API_KEY=
AI_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
